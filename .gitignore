# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/backups/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
*.tmp
*.bak
*.orig
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# Local AI tools and agent instructions (not application source)
/.agents/
/.claude/
/.codex/
/.cursor/
/AGENTS.md
/CLAUDE.md
/skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Admin uploads (persistent, outside git)
/storage/uploads/*
!/storage/uploads/.gitkeep
