# PostgreSQL Docker Compose; generate password: openssl rand -hex 32
POSTGRES_USER="r9host"
POSTGRES_PASSWORD="replace-with-generated-postgres-password"
POSTGRES_DB="r9host_topup"
# Samakan user/password/database pada URL dengan variabel Compose di atas.
DATABASE_URL="postgresql://r9host:replace-with-generated-postgres-password@127.0.0.1:5432/r9host_topup?schema=public"
# Pool size per proses Node (default 10; web+worker jangan melebihi max_connections PostgreSQL)
# DATABASE_CONNECTION_LIMIT=5

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"

# Opsional. Prioritas utama: Console → Website → URL Website.
# APP_URL hanya dipakai jika URL Website di pengaturan kosong.
# APP_URL="https://domain-anda.com"
UPLOAD_DIR="storage/uploads"
# Produksi VPS (disarankan, di luar folder app):
# UPLOAD_DIR="/var/www/r9host/storage/uploads"
PUBLIC_UPLOAD_URL="/uploads"

# Credential Cloudflare R2 disimpan via Console → Pengaturan → Website → Penyimpanan

# Cron secret juga bisa di-generate sekali dari Console → Website → Cron jobs (disimpan DB).
# Env ini opsional: dipakai sebagai fallback jika secret DB kosong.
# CRON_SECRET="generate-a-long-random-string"

# Redis Docker Compose; generate password: openssl rand -hex 32
# Samakan password di kedua variabel; gunakan URL encoding jika berisi karakter khusus.
REDIS_PASSWORD="r9host-local-redis-change-me"
REDIS_URL="redis://:r9host-local-redis-change-me@127.0.0.1:6379"
# Aktifkan hanya jika proxy menimpa X-Real-IP dan port app tidak terbuka publik.
TRUST_PROXY_HEADERS="false"
# Maksimum umur timestamp callback (detik); default 24 jam mengakomodasi retry DOKU 12 jam.
DOKU_NOTIFICATION_MAX_AGE_SECONDS=86400
